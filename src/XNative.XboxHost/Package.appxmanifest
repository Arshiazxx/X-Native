<?xml version="1.0" encoding="utf-8"?>
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:mp="http://schemas.microsoft.com/appx/2014/phone/manifest"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap mp rescap">

  <Identity
    Name="XNativeProject.XNative"
    Publisher="CN=X-Native Project"
    Version="0.1.0.0" />

  <mp:PhoneIdentity PhoneProductId="df935faa-6bd1-4644-aa48-bcb64369757f" PhonePublisherId="00000000-0000-0000-0000-000000000000" />

  <Properties>
    <DisplayName>X-Native</DisplayName>
    <PublisherDisplayName>X-Native Project</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Universal" MinVersion="10.0.17763.0" MaxVersionTested="10.0.19041.0" />
    <TargetDeviceFamily Name="Windows.Xbox" MinVersion="10.0.17763.0" MaxVersionTested="10.0.19041.0" />
  </Dependencies>

  <Resources>
    <Resource Language="en-US" />
  </Resources>

  <Applications>
    <Application Id="App"
      Executable="$targetnametoken$.exe"
      EntryPoint="XNative.XboxHost.App">
      <uap:VisualElements
        DisplayName="X-Native"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png"
        Description="Xbox Dev Mode compatibility platform."
        BackgroundColor="transparent">
        <uap:DefaultTile Wide310x150Logo="Assets\Wide310x150Logo.png" />
        <uap:SplashScreen Image="Assets\SplashScreen.png" />
      </uap:VisualElements>
    </Application>
  </Applications>

  <Capabilities>
    <Capability Name="internetClient" />
    <Capability Name="removableStorage" />
    <!--
      broadFileSystemAccess is a restricted capability. It grants access
      to the file system beyond the app sandbox, requires the user to
      grant consent at runtime (Settings &gt; Privacy), and is subject
      to additional Store review. It is requested here because X-Native
      is a Developer Mode launcher whose whole purpose is to discover
      games the user placed on internal or removable storage; that use
      is appropriate for Dev Mode sideloading, not for a general Store
      submission without further justification.
    -->
    <rescap:Capability Name="broadFileSystemAccess" />
  </Capabilities>
</Package>
